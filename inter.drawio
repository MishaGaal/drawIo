        <mxCell id="PJeIiZ8-Ms_5oPDwb-eA-132" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Velocity → Position інтегруємо ще раз:&lt;br&gt;&lt;div&gt;&lt;span class=&quot;ͼ11&quot;&gt;position&lt;/span&gt;&lt;span&gt;.x &lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;+=&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;velocity&lt;/span&gt;&lt;span&gt;.x &lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;*&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;dt&lt;/span&gt;&lt;span&gt;;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;ͼ11&quot;&gt;position&lt;/span&gt;&lt;span&gt;.y &lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;+=&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;velocity&lt;/span&gt;&lt;span&gt;.y &lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;*&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;dt&lt;/span&gt;&lt;span&gt;;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;position&lt;/span&gt;&lt;span&gt;.z &lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;+=&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;velocity&lt;/span&gt;&lt;span&gt;.z &lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;*&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;dt&lt;/span&gt;&lt;span&gt;;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="228" x="-535.5" y="1727" as="geometry" />
        </mxCell>
        <mxCell id="PJeIiZ8-Ms_5oPDwb-eA-137" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div align=&quot;left&quot;&gt;Беремо IMU показники&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;span class=&quot;ͼ11&quot;&gt;a_body&lt;/span&gt;&lt;span&gt; = [&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;ax&lt;/span&gt;&lt;span&gt;, &lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;ay&lt;/span&gt;&lt;span&gt;, &lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;az&lt;/span&gt;&lt;span&gt;]&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;span&gt;Отримуємо:&lt;/span&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;span class=&quot;ͼ11&quot;&gt;a_world&lt;/span&gt;&lt;span&gt; = [&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;ax_world&lt;/span&gt;&lt;span&gt;, &lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;ay_world&lt;/span&gt;&lt;span&gt;, &lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;az_world&lt;/span&gt;&lt;span&gt;]&lt;/span&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;span&gt;З викорисатнням:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;R(q) =&amp;nbsp;&lt;/div&gt;&lt;div&gt;[ 1 - 2(y² + z²)    2(xy - wz)        2(xz + wy)     ]&lt;/div&gt;&lt;div&gt;&amp;nbsp;[ 2(xy + wz)        1 - 2(x² + z²)    2(yz - wx)     ]&lt;/div&gt;&lt;div&gt;&amp;nbsp;[ 2(xz - wy)        2(yz + wx)        1 - 2(x² + y²) ]&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;div&gt;a_world = R(q) × a_body&lt;/div&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;br&gt;&lt;/div&gt;struct Vector3 {&lt;br&gt;&amp;nbsp; &amp;nbsp; float x;&lt;br&gt;&amp;nbsp; &amp;nbsp; float y;&lt;br&gt;&amp;nbsp; &amp;nbsp; float z;&lt;br&gt;};&lt;br&gt;&lt;br&gt;struct Quaternion {&lt;br&gt;&amp;nbsp; &amp;nbsp; float w;&lt;br&gt;&amp;nbsp; &amp;nbsp; float x;&lt;br&gt;&amp;nbsp; &amp;nbsp; float y;&lt;br&gt;&amp;nbsp; &amp;nbsp; float z;&lt;br&gt;};&lt;br&gt;&lt;br&gt;Vector3 rotateBodyToWorld(&lt;br&gt;&amp;nbsp; &amp;nbsp; const Vector3&amp;amp; body,&lt;br&gt;&amp;nbsp; &amp;nbsp; const Quaternion&amp;amp; q)&lt;br&gt;{&lt;br&gt;&amp;nbsp; &amp;nbsp; Vector3 world;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; const float w = q.w;&lt;br&gt;&amp;nbsp; &amp;nbsp; const float x = q.x;&lt;br&gt;&amp;nbsp; &amp;nbsp; const float y = q.y;&lt;br&gt;&amp;nbsp; &amp;nbsp; const float z = q.z;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; world.x =&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; (1.0f - 2.0f * (y*y + z*z)) * body.x +&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; (2.0f * (x*y - w*z))&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; * body.y +&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; (2.0f * (x*z + w*y))&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; * body.z;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; world.y =&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; (2.0f * (x*y + w*z))&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; * body.x +&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; (1.0f - 2.0f * (x*x + z*z)) * body.y +&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; (2.0f * (y*z - w*x))&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; * body.z;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; world.z =&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; (2.0f * (x*z - w*y))&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; * body.x +&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; (2.0f * (y*z + w*x))&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; * body.y +&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; (1.0f - 2.0f * (x*x + y*y)) * body.z;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; return world;&lt;br&gt;}&lt;div align=&quot;left&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="843" width="270" x="-940" y="950" as="geometry" />
        </mxCell>
        <mxCell id="PJeIiZ8-Ms_5oPDwb-eA-144" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div align=&quot;left&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;ω = [p, q, r] - де&amp;nbsp;&amp;nbsp;p = angular velocity around BODY X&lt;br&gt;q = angular velocity around BODY Y&lt;br&gt;r = angular velocity around BODY Z&amp;nbsp; (rad/s)&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;Ω = [0, p, q, r] - to perform quaternion mathematics, we turn that angular-velocity vector into a special quaternion:&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;p = gx&lt;br&gt;q = gy&lt;br&gt;r = gz&amp;nbsp; &amp;nbsp;тоді&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;code&gt;&lt;span&gt;Ω =&amp;nbsp;&lt;/span&gt;&lt;/code&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;code&gt;&lt;span&gt;[ 0  ]&lt;/span&gt;&lt;/code&gt;&lt;code&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/code&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;code&gt;&lt;span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;[ gx ]&lt;/span&gt;&lt;/code&gt;&lt;code&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/code&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;code&gt;&lt;span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;[ gy ]&lt;/span&gt;&lt;/code&gt;&lt;code&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/code&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;code&gt;&lt;span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;[ gz ]&lt;/span&gt;&lt;/code&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;q̇&amp;nbsp; - time derivative&amp;nbsp;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;q̇ = 1/2 q ⊗ Ω&amp;nbsp; - change&amp;nbsp;rate&amp;nbsp; of rotation seed&amp;nbsp;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;q = q + q̇ dt&amp;nbsp;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&amp;nbsp;q = normalize(q)&lt;div align=&quot;left&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;ω = [p, q, r] - де&amp;nbsp;&amp;nbsp;p = angular velocity around BODY X&lt;br&gt;q = angular velocity around BODY Y&lt;br&gt;r = angular velocity around BODY Z&amp;nbsp; (rad/s)&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;Ω = [0, p, q, r] - to perform quaternion mathematics, we turn that angular-velocity vector into a special quaternion:&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;p = gx&lt;br&gt;q = gy&lt;br&gt;r = gz&amp;nbsp; &amp;nbsp;тоді&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;code&gt;&lt;span&gt;Ω =&amp;nbsp;&lt;/span&gt;&lt;/code&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;code&gt;&lt;span&gt;[ 0  ]&lt;/span&gt;&lt;/code&gt;&lt;code&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/code&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;code&gt;&lt;span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;[ gx ]&lt;/span&gt;&lt;/code&gt;&lt;code&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/code&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;code&gt;&lt;span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;[ gy ]&lt;/span&gt;&lt;/code&gt;&lt;code&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/code&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;code&gt;&lt;span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;[ gz ]&lt;/span&gt;&lt;/code&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;q̇&amp;nbsp; - time derivative&amp;nbsp;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&amp;nbsp;q̇ = 1/2 q ⊗ Ω&amp;nbsp; - change&amp;nbsp;rate&amp;nbsp; of rotation seed&amp;nbsp;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;q = q + q̇ dt&amp;nbsp;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&amp;nbsp;q = normalize(q)&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;void updateAttitude(&lt;br&gt;&amp;nbsp; &amp;nbsp; float gyroX,&lt;br&gt;&amp;nbsp; &amp;nbsp; float gyroY,&lt;br&gt;&amp;nbsp; &amp;nbsp; float gyroZ,&lt;br&gt;&amp;nbsp; &amp;nbsp; float accelX,&lt;br&gt;&amp;nbsp; &amp;nbsp; float accelY,&lt;br&gt;&amp;nbsp; &amp;nbsp; float accelZ,&lt;br&gt;&amp;nbsp; &amp;nbsp; float dt)&lt;br&gt;{&lt;br&gt;&amp;nbsp; &amp;nbsp; // 1. Normalize accelerometer&lt;br&gt;&amp;nbsp; &amp;nbsp; normalizeVector(accelX, accelY, accelZ);&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; // 2. Calculate expected gravity direction&lt;br&gt;&amp;nbsp; &amp;nbsp; //&amp;nbsp; &amp;nbsp; from current quaternion&lt;br&gt;&amp;nbsp; &amp;nbsp; Vector3 gravity =&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; gravityFromQuaternion(q);&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; // 3. Compare measured vs expected gravity&lt;br&gt;&amp;nbsp; &amp;nbsp; Vector3 error =&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; calculateAttitudeError(&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; accelX, accelY, accelZ,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; gravity&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; );&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; // 4. Integral feedback&lt;br&gt;&amp;nbsp; &amp;nbsp; integral.x += Ki * error.x * dt;&lt;br&gt;&amp;nbsp; &amp;nbsp; integral.y += Ki * error.y * dt;&lt;br&gt;&amp;nbsp; &amp;nbsp; integral.z += Ki * error.z * dt;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; // 5. Correct gyro&lt;br&gt;&amp;nbsp; &amp;nbsp; float correctedGx =&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; gyroX + Kp * error.x + integral.x;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; float correctedGy =&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; gyroY + Kp * error.y + integral.y;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; float correctedGz =&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; gyroZ + Kp * error.z + integral.z;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; // 6. Convert angular velocity to quaternion&lt;br&gt;&amp;nbsp; &amp;nbsp; Quaternion omega = {&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 0.0f,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; correctedGx,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; correctedGy,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; correctedGz&lt;br&gt;&amp;nbsp; &amp;nbsp; };&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; // 7. Quaternion derivative&lt;br&gt;&amp;nbsp; &amp;nbsp; Quaternion qDot =&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 0.5f * multiply(q, omega);&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; // 8. Integrate&lt;br&gt;&amp;nbsp; &amp;nbsp; q.w += qDot.w * dt;&lt;br&gt;&amp;nbsp; &amp;nbsp; q.x += qDot.x * dt;&lt;br&gt;&amp;nbsp; &amp;nbsp; q.y += qDot.y * dt;&lt;br&gt;&amp;nbsp; &amp;nbsp; q.z += qDot.z * dt;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; // 9. Keep quaternion unit-length&lt;br&gt;&amp;nbsp; &amp;nbsp; normalize(q);&lt;br&gt;}&lt;/div&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;void updateAttitude(&lt;br&gt;&amp;nbsp; &amp;nbsp; float gyroX,&lt;br&gt;&amp;nbsp; &amp;nbsp; float gyroY,&lt;br&gt;&amp;nbsp; &amp;nbsp; float gyroZ,&lt;br&gt;&amp;nbsp; &amp;nbsp; float accelX,&lt;br&gt;&amp;nbsp; &amp;nbsp; float accelY,&lt;br&gt;&amp;nbsp; &amp;nbsp; float accelZ,&lt;br&gt;&amp;nbsp; &amp;nbsp; float dt)&lt;br&gt;{&lt;br&gt;&amp;nbsp; &amp;nbsp; // 1. Normalize accelerometer&lt;br&gt;&amp;nbsp; &amp;nbsp; normalizeVector(accelX, accelY, accelZ);&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; // 2. Calculate expected gravity direction&lt;br&gt;&amp;nbsp; &amp;nbsp; //&amp;nbsp; &amp;nbsp; from current quaternion&lt;br&gt;&amp;nbsp; &amp;nbsp; Vector3 gravity =&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; gravityFromQuaternion(q);&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; // 3. Compare measured vs expected gravity&lt;br&gt;&amp;nbsp; &amp;nbsp; Vector3 error =&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; calculateAttitudeError(&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; accelX, accelY, accelZ,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; gravity&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; );&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; // 4. Integral feedback&lt;br&gt;&amp;nbsp; &amp;nbsp; integral.x += Ki * error.x * dt;&lt;br&gt;&amp;nbsp; &amp;nbsp; integral.y += Ki * error.y * dt;&lt;br&gt;&amp;nbsp; &amp;nbsp; integral.z += Ki * error.z * dt;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; // 5. Correct gyro&lt;br&gt;&amp;nbsp; &amp;nbsp; float correctedGx =&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; gyroX + Kp * error.x + integral.x;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; float correctedGy =&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; gyroY + Kp * error.y + integral.y;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; float correctedGz =&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; gyroZ + Kp * error.z + integral.z;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; // 6. Convert angular velocity to quaternion&lt;br&gt;&amp;nbsp; &amp;nbsp; Quaternion omega = {&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 0.0f,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; correctedGx,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; correctedGy,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; correctedGz&lt;br&gt;&amp;nbsp; &amp;nbsp; };&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; // 7. Quaternion derivative&lt;br&gt;&amp;nbsp; &amp;nbsp; Quaternion qDot =&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 0.5f * multiply(q, omega);&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; // 8. Integrate&lt;br&gt;&amp;nbsp; &amp;nbsp; q.w += qDot.w * dt;&lt;br&gt;&amp;nbsp; &amp;nbsp; q.x += qDot.x * dt;&lt;br&gt;&amp;nbsp; &amp;nbsp; q.y += qDot.y * dt;&lt;br&gt;&amp;nbsp; &amp;nbsp; q.z += qDot.z * dt;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; // 9. Keep quaternion unit-length&lt;br&gt;&amp;nbsp; &amp;nbsp; normalize(q);&lt;br&gt;}&lt;/div&gt;" vertex="1">
          <mxGeometry height="1240" width="477" x="1910" y="53" as="geometry" />
        </mxCell>
        <mxCell id="PJeIiZ8-Ms_5oPDwb-eA-171" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div align=&quot;left&quot;&gt;EulerAngles quaternionToEuler(const Quaternion&amp;amp; q)&lt;br&gt;{&lt;br&gt;&amp;nbsp; &amp;nbsp; EulerAngles result;&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; // Roll&lt;br&gt;&amp;nbsp; &amp;nbsp; result.roll = atan2f(&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 2.0f * (q.w*q.x + q.y*q.z),&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 1.0f - 2.0f * (q.x*q.x + q.y*q.y)&lt;br&gt;&amp;nbsp; &amp;nbsp; );&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; // Pitch&lt;br&gt;&amp;nbsp; &amp;nbsp; float sinPitch =&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 2.0f * (q.w*q.y - q.z*q.x);&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; sinPitch = clamp(sinPitch, -1.0f, 1.0f);&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; result.pitch = asinf(sinPitch);&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; // Yaw&lt;br&gt;&amp;nbsp; &amp;nbsp; result.yaw = atan2f(&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 2.0f * (q.w*q.z + q.x*q.y),&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 1.0f - 2.0f * (q.y*q.y + q.z*q.z)&lt;br&gt;&amp;nbsp; &amp;nbsp; );&lt;br&gt;&lt;br&gt;&amp;nbsp; &amp;nbsp; return result;&lt;br&gt;}&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="300" x="390" y="1680" as="geometry" />
        </mxCell>
